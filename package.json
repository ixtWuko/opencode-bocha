{
  "name": "opencode-bocha",
  "version": "0.2.0",
  "description": "Bocha (博查) Web Search plugin for opencode v2 - websearch provider + bochawebsearch custom tool",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.29",
    "@types/node": "^25.7.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "plugin",
    "bocha",
    "web-search",
    "search"
  ],
  "license": "MIT"
}
